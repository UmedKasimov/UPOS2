{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "U-POS Телефон",
  "version": "0.6.2",
  "description": "SIP-телефон во вкладке или отдельном окне Chrome при закрытом сайте U-POS.",
  "permissions": ["contextMenus", "tabs", "storage", "offscreen", "notifications", "alarms", "scripting"],
  "host_permissions": ["https://app.u-pos.uz/*"],
  "content_scripts": [
    {"matches": ["https://app.u-pos.uz/*"], "js": ["site-bridge.js"], "run_at": "document_start"}
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Открыть телефон U-POS", "default_icon": "icon.png"}
}
